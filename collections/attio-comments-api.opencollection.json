{
  "opencollection": "1.0.0",
  "info": {
    "name": "Attio REST Attributes Comments API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Comments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a comment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.attio.com/v2/comments"
          },
          "docs": "Create a comment"
        },
        {
          "info": {
            "name": "Get a comment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.attio.com/v2/comments/:comment_id",
            "params": [
              {
                "name": "comment_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a comment"
        },
        {
          "info": {
            "name": "Delete a comment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.attio.com/v2/comments/:comment_id",
            "params": [
              {
                "name": "comment_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a comment"
        }
      ]
    }
  ],
  "bundled": true
}