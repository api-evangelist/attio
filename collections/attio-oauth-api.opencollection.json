{
  "opencollection": "1.0.0",
  "info": {
    "name": "Attio REST Attributes OAuth API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "OAuth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Exchange code for access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.attio.com/oauth/token"
          },
          "docs": "Exchange code for access token"
        },
        {
          "info": {
            "name": "Introspect token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.attio.com/oauth/introspect"
          },
          "docs": "Introspect token"
        }
      ]
    }
  ],
  "bundled": true
}