{
  "opencollection": "1.0.0",
  "info": {
    "name": "Attio REST Attributes Lists API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Lists",
