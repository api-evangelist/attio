                "type": "path"
              }
            ]
          },
          "docs": "Get a list"
        },
        {
          "info": {
            "name": "Update a list",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.attio.com/v2/lists/:list_id",
            "params": [
              {
                "name": "list_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update a list"
        }
      ]
    }
  ],
  "bundled": true
}