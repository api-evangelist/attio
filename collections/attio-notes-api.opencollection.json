{
  "opencollection": "1.0.0",
  "info": {
    "name": "Attio REST Attributes Notes API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Notes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List notes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.attio.com/v2/notes"
          },
          "docs": "List notes"
        },
        {
          "info": {
            "name": "Create a note",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.attio.com/v2/notes"
          },
          "docs": "Create a note"
        }
      ]
    }
  ],
  "bundled": true
}