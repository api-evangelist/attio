{
  "opencollection": "1.0.0",
  "info": {
    "name": "Attio REST Attributes Tasks API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tasks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.attio.com/v2/tasks"
          },
          "docs": "List tasks"
        },
        {
          "info": {
            "name": "Create a task",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.attio.com/v2/tasks"
          },
          "docs": "Create a task"
        }
      ]
    }
  ],
  "bundled": true
}